{
  "name": "silver-city",
  "private": true,
  "version": "1.4.200",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "node scripts/embed-packs.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "embed:packs": "node scripts/embed-packs.mjs",
    "test": "node scripts/run-checks.mjs all",
    "android:sync": "npm run build && node scripts/cap-sync.mjs android",
    "ios:sync": "npm run build && node scripts/cap-sync.mjs ios",
    "cap:sync": "npm run build && node scripts/cap-sync.mjs",
    "android:apk": "npm run android:sync && node scripts/write-android-local-properties.mjs && cd android && ./gradlew assembleDebug",
    "test:core": "node scripts/run-checks.mjs core",
    "test:dig": "node scripts/run-checks.mjs dig",
    "test:arcade": "node scripts/run-checks.mjs arcade",
    "test:city": "node scripts/run-checks.mjs city",
    "test:commerce": "node scripts/run-checks.mjs commerce",
    "test:css": "node scripts/run-checks.mjs css",
    "test:juice": "node scripts/run-checks.mjs juice"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3"
  }
}

# One-time Play / App Store / ads connect. Blank = demo cannotCharge path.
# Do not claim store money until a plugin AND these flags are live.
# Copy to .env (gitignored) when connecting. No weekly Bill work.

VITE_PLAY_BILLING=
VITE_STOREKIT=
VITE_ADS_ENABLED=
VITE_ADMOB_APP_ID=
VITE_ADMOB_APP_ID_IOS=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_INTERSTITIAL_ID_IOS=

# Store-free Pages support. Bill-editable. Do not flip the store flags above.
VITE_TIP_URL=https://ko-fi.com/
VITE_MILL_PACK_URL=https://ko-fi.com/
VITE_HARBOR_PACK_URL=https://ko-fi.com/
